{
  "name": "typosquat-dependency-companion",
  "displayName": "Typosquat Dependency Companion",
  "description": "Flags a package.json dependency whose name is a near-miss (edit distance 1-2) of a much more popular package -- possible typosquat/dependency confusion. No data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "security",    "typosquat",    "supply-chain",    "npm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-typosquat-dependency-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-typosquat-dependency-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
